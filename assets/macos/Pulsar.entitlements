<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Under the hardened runtime (required for notarization) microphone
	     access is denied unless this entitlement is present, regardless of the
	     NSMicrophoneUsageDescription prompt. Needed for voice drops / capture. -->
	<key>com.apple.security.device.audio-input</key>
	<true/>
</dict>
</plist>
