@startuml
title TASK-260712-1c04pk - macOS shell runtime and future seams

left to right direction
skinparam packageStyle rectangle
skinparam shadowing false

actor User

package "NodeAppUI (SwiftUI, macOS 14)" {
  rectangle "PulsarShellModel\n@Observable shared projection" as Model
  rectangle "PulsarMainView\nNavigationSplitView" as Main
  rectangle "EN/RU shell catalog\ntext + symbol state semantics" as Copy
  rectangle "PulsarShellActions\ncapability seams" as Actions
}

package "Existing AppKit lifecycle" {
  rectangle "PulsarMainWindowController\nNSHostingController bridge" as Window
  rectangle "StatusMenuController\nNSStatusItem + commands" as Menu
  rectangle "Onboarding + Sparkle + signals" as Lifecycle
}

package "Existing runtime" {
  rectangle "CoordinatorClient\nauthenticated health" as Coordinator
  rectangle "PlayerCore\nnow playing / DND / volume" as Player
  rectangle "DirectOutputMonitor\ncurrent route" as Route
}

package "Strict later tasks" {
  rectangle "Capture + hotkey\nTASK-260712-30abcm / ut6akw" as Capture
  rectangle "Self-test + file intake\nTASK-260712-3lg0ht / 1s6h6t" as SelfTest
  rectangle "HTTP data integration\nTASK-260712-3dqc3l" as Data
}

User --> Main
User --> Menu
Window --> Main
Main --> Model
Menu --> Model
Copy --> Main
Copy --> Menu
Main --> Actions
Menu --> Actions
Lifecycle --> Window : preserves current process lifecycle
Coordinator --> Model : online / reconnecting
Player --> Model : now playing / DND / volume
Route --> Model : output route
Actions --> Player : local DND + volume
Capture --> Actions : enable record / stop
Capture --> Model : recording state
SelfTest --> Actions : enable Try locally
