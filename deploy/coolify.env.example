# Barycenter env for Coolify (v2). Copy values into the Coolify app's
# Environment Variables — never commit real secrets.

# External base URL (the subdomain served by the reverse proxy).
DUET_PUBLIC_URL=https://barycenter.relux.works

# Log verbosity: debug|info|warn|error. Prod = info; debug is high-volume and
# may log WS payloads — set it only to trace a live issue, then set back.
DUET_LOG_LEVEL=info

# Node tokens: openssl rand -hex 32 (one per home).
DUET_NODE_A_TOKEN=
DUET_NODE_B_TOKEN=

# Telegram (BotFather token; group chat id; user_id:home pairs).
DUET_TELEGRAM_BOT_TOKEN=
DUET_TELEGRAM_CHAT_ID=
DUET_TELEGRAM_USERS=111111111:a,222222222:b

# Spotify Web API app (playlist expansion, U10) — developer.spotify.com.
DUET_SPOTIFY_CLIENT_ID=
DUET_SPOTIFY_CLIENT_SECRET=

# ---------------------------------------------------------------------------
# Litestream backups (deploy/docker-compose.yml + deploy/litestream.yml).
# Continuous replication of /var/lib/duet/duet.db to S3-compatible object
# storage. WITHOUT these the sidecar just no-ops and the DB is unprotected.
# Provide your own bucket + credentials — never commit real values.
# See docs/backup-restore.md for setup and restore.
# ---------------------------------------------------------------------------
# Bucket name (create it first at your object-storage provider).
LITESTREAM_BUCKET=
# Object path/prefix inside the bucket (leave as-is unless you share a bucket).
LITESTREAM_PATH=duet.db
# Endpoint for S3-compatible providers (Backblaze B2 / Cloudflare R2 / MinIO /
# Hetzner). Leave EMPTY for real AWS S3.
LITESTREAM_ENDPOINT=
# Region (AWS needs one, e.g. eu-central-1; most S3-compatibles accept "auto"
# or any value). Leave empty only if your provider ignores it.
LITESTREAM_REGION=
# Credentials scoped to the bucket (Litestream reads these natively).
LITESTREAM_ACCESS_KEY_ID=
LITESTREAM_SECRET_ACCESS_KEY=
