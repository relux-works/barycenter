@startuml
title P1 Windows five-second local self-test
actor User
participant "Window / tray" as UI
participant "Workflow" as W
participant "Self-test" as S
participant "Capture service" as C
participant "Signed helper" as H
participant "Private store" as Store
participant "Production mixer" as M

User -> UI : Run local self-test
UI -> W : TryLocally()
W -> S : RecordFiveSeconds(selectedInput)
S -> C : Start(explicit, self_test, meter)
C -> M : play start cue
C -> H : permission + open input
H --> UI : meter projection
... exactly 5 seconds ...
S -> C : Stop(user_stop)
C -> H : stop / release stream
C -> M : play stop cue
C -> Store : finalize disposable self-test
C --> S : completed draft
S -> M : play completed draft locally
M --> S : ended
S --> UI : reviewing_draft

alt Escape / lock / suspend / quit / revoke
  UI -> W : typed cancel/lifecycle reason
  W -> S : Close()
  S -> C : cancel active capture
  S -> Store : delete owned self-test
end
@enduml
