{
  "schema_version": 1,
  "contract_id": "pulsar.capture-media-lifecycle.v1",
  "cue": {
    "asset_id": "pulsar.recording-cue.v1",
    "sha256": "479b1a9d605ac12454e3449e129991b7ce8599251506ca54a93be0b6144730fd",
    "source_path": "assets/audio/pulsar-recording-cue.wav",
    "macos_package_path": "Contents/Resources/Audio/pulsar-recording-cue.wav",
    "windows_package_path": "Assets/Audio/pulsar-recording-cue.wav",
    "start_sequence": [
      "open_capture_session_without_committing_microphone_samples",
      "play_start_cue",
      "after_start_cue_completion_enable_microphone_commit"
    ],
    "stop_sequence": [
      "disable_microphone_commit",
      "close_and_finalize_capture_writer",
      "after_capture_close_play_stop_cue"
    ]
  },
  "storage": {
    "root": "app-private/capture-media-v1",
    "permissions": "owner-only",
    "identifier": "128-bit random lowercase hexadecimal; never a source filename",
    "classes": {
      "self_test": {
        "partial_suffix": ".partial.wav",
        "final_suffix": ".selftest.wav",
        "network_allowed": false,
        "survives_restart": false,
        "cleanup": ["cancel", "close", "explicit_delete", "startup_recovery"]
      },
      "user_recording": {
        "partial_suffix": ".partial.wav",
        "final_suffix": ".draft.wav",
        "network_allowed_after": "durable_unsent",
        "survives_restart_after": "durable_unsent",
        "cleanup": ["confirmed_upload", "explicit_delete"]
      }
    }
  },
  "states": [
    "absent",
    "capturing_partial",
    "finalizing",
    "self_test_local",
    "durable_unsent",
    "uploading",
    "uploaded_confirmed",
    "deleted"
  ],
  "transitions": [
    {"class": "self_test", "from": "absent", "action": "begin", "to": "capturing_partial"},
    {"class": "self_test", "from": "capturing_partial", "action": "stop", "to": "finalizing"},
    {"class": "self_test", "from": "finalizing", "action": "finalize_succeeded", "to": "self_test_local"},
    {"class": "self_test", "from": "capturing_partial", "action": "cancel", "to": "deleted"},
    {"class": "self_test", "from": "finalizing", "action": "finalize_failed", "to": "deleted"},
    {"class": "self_test", "from": "self_test_local", "action": "close", "to": "deleted"},
    {"class": "self_test", "from": "self_test_local", "action": "explicit_delete", "to": "deleted"},
    {"class": "user_recording", "from": "absent", "action": "begin", "to": "capturing_partial"},
    {"class": "user_recording", "from": "capturing_partial", "action": "stop", "to": "finalizing"},
    {"class": "user_recording", "from": "finalizing", "action": "finalize_succeeded", "to": "durable_unsent"},
    {"class": "user_recording", "from": "capturing_partial", "action": "cancel", "to": "deleted"},
    {"class": "user_recording", "from": "finalizing", "action": "finalize_failed", "to": "deleted"},
    {"class": "user_recording", "from": "durable_unsent", "action": "begin_upload", "to": "uploading"},
    {"class": "user_recording", "from": "uploading", "action": "upload_failed_or_interrupted", "to": "durable_unsent"},
    {"class": "user_recording", "from": "uploading", "action": "upload_confirmed", "to": "uploaded_confirmed"},
    {"class": "user_recording", "from": "uploaded_confirmed", "action": "cleanup", "to": "deleted"},
    {"class": "user_recording", "from": "durable_unsent", "action": "explicit_delete", "to": "deleted"}
  ],
  "startup_recovery": {
    "delete": ["all partial files", "all finalized self-test files", "orphan temporary picker copies"],
    "retain": ["all structurally valid durable unsent user drafts"],
    "quarantine_or_delete": ["invalid or truncated durable files; never present them as sendable"]
  },
  "picker": {
    "source_filename_retained": false,
    "source_path_retained": false,
    "security_token_retained": false,
    "rule": "copy approved bytes into a newly allocated app-private partial, close external access, then validate and atomically finalize as a durable unsent draft"
  },
  "logging": {
    "allowed": ["storage_class", "lifecycle_state", "fixed operation code", "content-free opaque draft id"],
    "forbidden": ["absolute path", "source filename", "external security token", "audio bytes", "upload token"]
  },
  "invariants": [
    "self-test never creates an upload session, coordinator call, control token or transmission",
    "a partial file is never sendable and never appears in draft history",
    "cancel and failed finalization delete every owned partial",
    "a finalized user recording is fsynced and atomically renamed before becoming durable_unsent",
    "coordinator outage, upload failure and app restart retain durable_unsent",
    "only confirmed upload or explicit delete removes a valid durable_unsent draft",
    "start cue completes before the first microphone sample is committed",
    "capture closes before stop cue playback begins",
    "paths and source filenames never enter logs or user-visible failure copy"
  ],
  "failure_copy": {
    "en": {
      "cue_unavailable": "The recording cue is unavailable. Recording did not start.",
      "draft_retained": "Upload is unavailable. Your recording is saved on this device for retry.",
      "draft_cleanup_failed": "The recording could not be removed. Try again before signing out or uninstalling."
    },
    "ru": {
      "cue_unavailable": "Сигнал записи недоступен. Запись не началась.",
      "draft_retained": "Загрузка недоступна. Запись сохранена на этом устройстве для повторной попытки.",
      "draft_cleanup_failed": "Не удалось удалить запись. Повтори попытку до выхода или удаления приложения."
    }
  }
}
