      "requirements": ["E2EE-007", "E2EE-008", "E2EE-009"],
      "rule": "Use one canonical MLS wire format and application-owned target, media, generation and replay state; reject forks, stale epochs and nonce reuse before plaintext release."
    },
    {
      "id": "GC-R04",
      "requirements": ["E2EE-010", "E2EE-018"],
      "rule": "Negotiate one reviewed capability and suite without downgrade; unsupported or legacy targets fail or are explicitly excluded."
    },
    {
      "id": "GC-R05",
      "requirements": ["E2EE-012", "E2EE-013"],
      "rule": "New devices receive no history automatically and the coordinator never escrows group, epoch, recovery or history-grant secrets."
    },
    {
      "id": "GC-R06",
      "requirements": ["E2EE-002", "E2EE-014", "E2EE-017"],
      "rule": "Persist secrets only in reviewed client storage, delete consumed and obsolete representations, and keep keys out of logs, crash reports, metrics and backups."
    },
    {
      "id": "GC-R07",
      "requirements": ["E2EE-003", "E2EE-021"],
      "rule": "Treat delivery as malicious for content while using secure transport and separately detecting withholding, reordering, replay, forks and device-set equivocation."
