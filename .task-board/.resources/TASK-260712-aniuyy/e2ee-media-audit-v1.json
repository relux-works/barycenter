{
  "schemaVersion": 1,
  "contract": "e2ee-media-audit.v1",
  "status": "audit-only-production-disabled",
  "capability": {
    "name": "e2ee_media_v1",
    "advertisementAllowed": false,
    "selectedSuite": null,
    "productionSuites": []
  },
  "protocolBasis": "RFC 9420 semantics; no production library or cipher suite selected",
  "mediaKinds": ["clip", "live_ptt", "saved_cue", "track"],
  "clientOwnedSecrets": [
    "device-signature-private-key",
    "mls-key-package-private-material",
    "mls-epoch-secrets",
    "media-content-keys",
    "history-grant-secrets",
    "recovery-transfer-secrets"
  ],
  "coordinatorVisibleFields": [
    "contract", "capability", "suite", "event_id", "group_id", "actor_id",
    "device_id", "air_id", "target_snapshot_digest", "object_kind", "object_id",
    "epoch", "generation", "sequence", "nonce", "expires_at_ms",
    "manifest_digest", "authenticated_data_digest", "signature", "ciphertext_url"
  ],
  "coordinatorForbiddenFields": [
    "plaintext", "content_key", "epoch_secret", "sender_key", "recovery_secret",
    "history_grant_secret", "private_key", "key_package_private_key"
  ],
  "authenticatedData": [
    "contract", "capability", "suite", "event_id", "group_id", "actor_id",
    "device_id", "air_id", "target_snapshot_digest", "object_kind", "object_id",
    "epoch", "generation", "sequence", "nonce", "expires_at_ms", "manifest_digest"
  ],
  "commitFields": [
    "contract", "capability", "suite", "event_id", "group_id", "actor_id",
    "device_id", "air_id", "previous_epoch", "epoch", "previous_commit_digest",
    "commit_digest", "target_snapshot_digest", "authenticated_data_digest", "signature"
  ],
  "stateRules": [
    "verified client devices author add, remove, update and commit operations",
    "accepted commits advance exactly one epoch and bind the previous commit digest",
    "concurrent commits are serialized by the previous commit digest; stale and forked commits fail closed",
    "content is accepted only for the current epoch and exact immutable target snapshot",
    "sender generation and sequence are monotonic per object and nonce tuples never repeat",
    "restart restores epoch, commit, replay, generation and nonce state before decryption",
    "new devices receive no history unless a current verified device issues an expiring history grant",
    "leave, removal, device revoke and recovery rotate the epoch before later content",
    "deletion is best effort and cannot revoke plaintext or keys already copied by a recipient",
    "voluntary reports export only the reporter-selected plaintext and authenticated evidence boundary",
    "unsupported clients never display an encrypted affordance and no plaintext downgrade is allowed"
  ],
  "flows": {
    "membership": ["key-package", "proposal", "commit", "welcome", "epoch-confirmation"],
    "storedMedia": ["local-prepare", "content-key", "encrypted-container", "per-target-envelope", "manifest", "ciphertext-route"],
    "livePTT": ["epoch-bound-session-key", "sender-generation", "monotonic-frame-sequence", "unique-frame-nonce", "terminal-rotation"],
    "history": ["current-device-approval", "object-range-bound-grant", "expiry", "recipient-device-binding", "local-import"],
    "recovery": ["new-verified-device", "peer-approved-transfer", "epoch-rotation", "explicit-history-grants"],
    "report": ["local-decrypt", "explicit-user-selection", "evidence-package", "moderation-upload"]
  },
  "failureCodes": [
    "downgrade", "expired_grant", "foreign_target", "forked_epoch",
    "invalid_signature", "nonce_reuse", "replay", "stale_epoch",
    "tampered_manifest", "unknown_suite"
  ]
}
