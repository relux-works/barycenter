{
  "schemaVersion": 1,
  "contract": "p2-targets-inbox-parity.v1",
  "extends": [
    "p1-transmission-v1",
    "p1-history-presence-telegram-v1",
    "p1-moderation-control-plane.v1",
    "p2-air-lifecycle.v1"
  ],
  "reuse": {
    "identityAuthority": "ActorContext and current binding generation",
    "audienceAuthority": "p1 transmission immutable target snapshot",
    "mediaAuthority": "ready media plus exact target snapshot row",
    "historyAuthority": "p1 history projection and cursor store",
    "moderationAuthority": "p1 moderation_reports, evidence and operator decisions",
    "telegramAuthority": "verified Telegram identity routed through the common application service",
    "parallelACLAllowed": false,
    "parallelHistoryAllowed": false,
    "parallelModerationAllowed": false,
    "telegramOwnedDeliveryStateAllowed": false
  },
  "ids": {
    "inbox": "ib_ plus 26-character Crockford ULID generated by coordinator",
    "replayRequest": "ir_ plus 26-character Crockford ULID generated by coordinator",
    "targetReference": "opaque trf_ capability resolved only inside caller domain",
    "cursor": "ic_ plus random 192-bit capability; only SHA-256 digest is stored",
    "callerSuppliedPrimaryIDsAllowed": false
  },
  "strictJSON": {
    "unknownFields": "reject",
    "duplicateFields": "reject",
    "explicitNull": "reject",
    "trailingValues": "reject",
    "maximumBodyBytes": 16384,
    "timestamps": "RFC3339 UTC milliseconds",
    "optionalFields": "omit-not-null"
  },
  "capabilities": {
    "clip": [
      "media_clip_v1"
    ],
    "track": [
      "audio_track_v1",
      "queue_replace_v1",
      "stream_variant_v1"
    ],
    "inboxPresentation": [
      "inbox_v1"
    ],
    "explicitTargetPresentation": [
      "explicit_targets_v2"
    ],
    "registration": "unique ASCII-sorted strings; reconnect replaces the prior set"
  },
  "create": {
    "route": "POST /v1/transmissions",
    "audienceKinds": [
      "this_pulsar",
      "own_barycenter",
      "current_air",
      "explicit"
    ],
    "explicitTargetKinds": [
      "barycenter",
      "pulsar"
    ],
    "maximumSelectors": 64,
    "deduplicateBeforeOriginFilter": true,
    "zeroTargets": "422 audience_empty",
    "outsideDomainOrStale": "404 audience_not_found",
    "identityFieldsInRequestAllowed": false,
    "acceptedAtAuthority": "coordinator application-service ingress",
    "stableOrder": "accepted_at_ms ASC, transmission_id ASC",
    "idempotency": "actor plus credential scope plus Idempotency-Key plus canonical body hash",
    "contentPolicyGrantRequiredForUserMedia": true
  },
  "targetSnapshot": {
    "fields": [
      "orbit_id",
      "slot",
      "actor_id",
      "binding_generation",
      "capability_set_hash",
      "resolved_at_ms"
    ],
    "persistInCreateTransaction": true,
    "includesOfflineBindings": true,
    "laterMemberExpansionAllowed": false,
    "replacementBindingInheritsAccess": false,
    "currentAirMembershipAloneGrantsAccess": false,
    "nonTargetKnownIDResult": "404 nonexistence surface",
    "blockedTargetGrantsMediaBytes": false
  },
  "mediaDelivery": {
    "clipKinds": [
      "voice_clip",
      "audio_clip",
      "builtin_cue"
    ],
    "clipDeliveries": [
      "overlay",
      "interrupt",
      "after_current"
    ],
    "trackKind": "audio_track",
    "trackDeliveries": [
      "queue",
      "replace"
    ],
    "deliveryKindMismatch": "422 delivery_kind_mismatch",
    "targetedTrack": {
      "oneTransmission": true,
      "oneImmutableTargetRowPerResolvedInstallation": true,
      "nonTargetSameAirDiscoversMetadata": false,
      "nonTargetMainProgramChanges": false,
      "queue": "append inside each exact target playback domain",
      "replace": "generation-safe fade and replace inside each exact target playback domain",
      "broadcastFallbackAllowed": false
    }
  },
  "mixedVersion": {
    "decisionTime": "before create transaction commits",
    "mandatoryOnlineTargetMissingRequiredCapability": "422 unsupported_targets",
    "partialCreateAllowed": false,
    "unsupportedTargetsResponse": "opaque target references plus sorted missing capability names",
    "offlineTargetUnknownCapability": "snapshot target and allow missed_offline inbox; never late autoplay",
    "phase1ClipTarget": "allowed only when media_clip_v1 and the requested Phase 1 delivery are supported",
    "phase1TrackTarget": "unsupported; no transmission or inbox row is created",
    "capabilityLossAfterPrepare": "target fails with existing failed/capability_lost receipt; peers do not downgrade",
    "unknownEnum": "render unsupported and preserve raw value; never coerce to a known action"
  },
  "inboxEligibility": {
    "source": "one exact immutable transmission target row",
    "eligible": [
      "missed_offline/offline_at_acceptance",
      "missed_offline/offline_before_prepare",
      "missed_offline/offline_before_start",
      "missed_dnd/local_dnd",
      "missed_dnd/orbit_dnd",
      "missed_not_ready/prepare_deadline",
      "failed/connection_lost",
      "failed/device_unavailable",
      "failed/audio_graph_failed"
    ],
    "ineligibleTargetStates": [
      "blocked",
      "played",
      "cancelled",
      "expired"
    ],
    "ineligibleFailureReasons": [
      "media_auth_failed",
      "media_expired",
      "hash_mismatch",
      "decode_failed",
      "duration_mismatch",
      "stale_play",
      "internal_error"
    ],
    "creation": "same transaction as first eligible terminal receipt",
    "defaultTTLSeconds": 2592000,
    "expiresAt": "minimum of receipt plus TTL, media expiry and policy retention",
    "autoPlayOnReconnect": false,
    "autoQueueOnReconnect": false,
    "notificationCreatesPlaybackAuthority": false,
    "newAirMemberDiscoversPriorItems": false,
    "formerTargetAfterBindingReplacement": "404 and no replay authority"
  },
  "inboxEntry": {
    "requiredFields": [
      "id",
      "revision",
      "transmission_id",
      "media_id",
      "target_reference",
      "media_kind",
      "requested_delivery",
      "effective_delivery",
      "missed_status",
      "missed_reason",
      "availability",
      "created_at",
      "expires_at",
      "replay_root_transmission_id",
      "replay_depth",
      "actions"
    ],
    "availabilityValues": [
      "available",
      "dismissed",
      "replayed",
      "unavailable",
      "expired"
    ],
    "actions": [
      "replay",
      "dismiss",
      "report",
      "block_actor",
      "block_orbit",
      "unblock"
    ],
    "sourceIdentity": "localized display label only; no actor, orbit, slot or Telegram numeric identifier",
    "receiptAggregate": "reuse p1 history aggregate; target sees only its exact target row",
    "actionHintsAreAuthority": false
  },
  "pagination": {
    "route": "GET /v1/inbox",
    "order": "created_at DESC, inbox_id DESC",
    "defaultLimit": 20,
    "minimumLimit": 1,
    "maximumLimit": 100,
    "cursorTTLSeconds": 86400,
    "maximumLiveCursorsPerActor": 128,
    "binds": [
      "actor_id",
      "credential_scope_hash",
      "current_binding_generation",
      "view",
      "limit",
      "upper_created_at",
      "upper_inbox_id",
      "last_created_at",
      "last_inbox_id"
    ],
    "clientTokenContainsTenantOrMediaID": false,
    "membershipChangesExpandFrozenPage": false
  },
  "replay": {
    "route": "POST /v1/inbox/{inbox_id}/replays",
    "manualExplicitActionRequired": true,
    "reauthorizeActorBindingMediaAndPolicy": true,
    "createsNewTransmission": true,
    "mutatesOriginalReceipt": false,
    "target": "same exact current recipient installation unless a separate authorized explicit audience is supplied",
    "idempotencyRequired": true,
    "maximumDepth": 8,
    "lineageFields": [
      "replay_of_inbox_id",
      "replay_of_transmission_id",
      "replay_root_transmission_id",
      "replay_depth"
    ],
    "unavailableResult": "404 inbox_not_found",
    "depthExceededResult": "409 replay_depth_exceeded",
    "lateAutoPlayAllowed": false
  },
  "statusAndDelete": {
    "statusRoutes": [
      "GET /v1/inbox",
      "GET /v1/inbox/{inbox_id}",
      "GET /v1/history",
      "GET /v1/history/{history_item_id}",
      "GET /v1/transmissions/{transmission_id}"
    ],
    "localDismissRoute": "DELETE /v1/inbox/{inbox_id}",
    "localDismissDeletesMedia": false,
    "localDismissCancelsOtherTargets": false,
    "senderDeleteAuthority": "existing media delete action with control reauthorization",
    "senderDelete": "revoke fetch first, cancel pending/active work, remove replay actions, retain terminal receipts",
    "disable": "reuse moderator actor/orbit disable and media delete enforcement",
    "deletedDisabledOrExpiredFetch": "404 nonexistence surface",
    "alreadyOpenBoundedChunk": "may finish; grants no new open or refill"
  },
  "contentPolicy": {
    "contract": "p2-content-policy-consent.v1",
    "currentVersion": "1.0",
    "currentPolicyHash": "a4d59ec7e9bfd8aeb2ec5d84356517580bde8df4540e6a2162f9206cd7ecd30e",
    "localeHashes": {
      "en": "a25d1b46b530fb64f18224618701f67ed80ace9ce5c1b1cfb1a7c3d70a1988ca",
      "ru": "4726df3e447674a5d6a87a34a5f05363c53604a80da3c1d6e69a3f9c05f41082"
    },
    "controllingLanguage": "en",
    "termsURL": "https://barycenter.live/legal/terms",
    "contentGuidelinesURL": "https://barycenter.live/legal/content-guidelines",
    "displayRoute": "GET /v1/content-policy?locale=en|ru",
    "currentGrantRoute": "GET /v1/content-policy/acceptance",
    "acceptRoute": "PUT /v1/content-policy/acceptance",
    "revokeRoute": "DELETE /v1/content-policy/acceptance?locale=en|ru",
    "grantKey": "actor_id plus policy_version",
    "persistedFields": [
      "actor_id",
      "orbit_id",
      "policy_version",
      "policy_hash",
      "locale",
      "accepted_via",
      "terms_accepted",
      "accepted_at",
      "revoked_at",
      "revision"
    ],
    "contentFilenameOrRawTransportIDStored": false,
    "currentVersionOwnedByServer": true,
    "clientTimestampTrusted": false,
    "termsAcceptanceSeparateFromPerUploadRightsReminder": true,
    "perUploadRightsAcknowledgementField": "rights_acknowledged=true",
    "acceptanceProvesOwnershipOrLegalValidity": false,
    "requiredFor": [
      "user media upload",
      "create transmission",
      "manual replay"
    ],
    "telegramAudioDocumentCheckedBeforeDownload": true,
    "legacyTelegramVoicePolicyUnchanged": true,
    "surfaces": [
      "coordinator HTTP",
      "Windows",
      "macOS",
      "Telegram"
    ],
    "missingOrStale": "428 content_policy_acceptance_required",
    "policyUpgradeInvalidatesOldGrantForNewActions": true,
    "oldAcceptedMediaRetention": "unchanged unless deleted, disabled, expired or quarantined"
  },
  "moderation": {
    "reportRoute": "reuse POST /v1/history/{history_item_id}/actions/report",
    "reportRequiresExactCurrentTargetEvidence": true,
    "reportImmediateGlobalEffect": "none",
    "reporterLocalEffects": [
      "hide or mark unavailable for reporter",
      "deny reporter replay",
      "stop reporter target playback",
      "optional existing actor or orbit block"
    ],
    "reportDoesNot": [
      "delete media",
      "cancel unrelated targets",
      "disable sender",
      "disable orbit",
      "grant moderator authority"
    ],
    "quarantine": {
      "authority": "moderation operator decision with quarantine capability",
      "effect": "deny new non-moderator fetch, delivery and replay globally while preserving evidence",
      "reversible": true,
      "audited": true,
      "reportCountThresholdAllowed": false
    },
    "deleteMedia": "terminal reviewed operator decision using existing delete enforcement",
    "disableActorOrOrbit": "terminal authority revocation using existing moderation enforcement",
    "antiDenialOfService": "reports alone never create quarantine, delete or disable side effects"
  },
  "parity": {
    "applicationService": "one common target, inbox, replay, delete and report service",
    "surfaces": [
      "coordinator HTTP",
      "Windows",
      "macOS",
      "Telegram"
    ],
    "sameFieldsEnumsAuthorizationAndErrors": true,
    "telegramCallbacks": "versioned HMAC-bound opaque action plus object ID, actor scope, nonce and expiry",
    "telegramCallbackCarriesBearerOrNumericIdentity": false,
    "telegramLocalQueueAllowed": false,
    "presentation": "shared localization keys; unsupported values remain explicit"
  },
  "errors": [
    "400 invalid_request",
    "401 unauthorized",
    "403 insufficient_capability",
    "404 audience_not_found",
    "404 inbox_not_found",
    "404 media_not_found",
    "409 replay_depth_exceeded",
    "409 idempotency_conflict",
    "410 cursor_expired",
    "422 audience_empty",
    "422 delivery_kind_mismatch",
    "422 unsupported_targets",
    "428 content_policy_acceptance_required"
  ]
}
