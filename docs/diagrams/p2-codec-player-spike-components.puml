@startuml
title P2 codec/player spike candidate and handoff seams
left to right direction
skinparam packageStyle rectangle

package "Shared spike inputs" {
  component "Fixture corpus\nMP3 / AAC / Opus\n2h, VBR, corrupt, seek-heavy" as Fixtures
  component "Comparison rubric\n20.2 proof items\n20.5 gate metrics" as Rubric
}

package "Coordinator-side prototype" {
  component "stream_variants SQLite catalog\ncontent-addressed manifests\nchunk hashes + VBR seek map" as Variants
  component "Authenticated range harness\nimmutable target snapshot\n206 / 304 / 416 + ETag" as RangeHarness
  component "Installation-private chunk cache\n512 MiB / 64 MiB variant\nHMAC keys + atomic LRU" as CacheContract
}

package "Node candidate probes" {
  component "Pure-Go path\nWindows + macOS" as PureGo
  component "Media Foundation path\nWindows packaged probe" as MF
  component "Bundled decoder path\nWindows + macOS" as Bundled
}

component "Current node scheduling seam\nready -> resume_at -> mixer" as Scheduler
component "Metrics collector\nRSS, skew, seek-to-audio,\nrange faults, cache reuse" as Metrics
component "Legal and distribution matrix" as Legal
component "Accepted no-go ADR\nproduction registry empty" as ADR
component "Candidate-neutral handoff\nrange + cache + scheduler + test doubles" as Handoff
component "Production streamed playback\nBLOCKED pending replacement ADR" as Production

Fixtures --> RangeHarness
Rubric --> Metrics
Variants --> RangeHarness
RangeHarness --> CacheContract : verified <= 1 MiB chunks
CacheContract --> PureGo
CacheContract --> MF
CacheContract --> Bundled
RangeHarness --> PureGo
RangeHarness --> MF
RangeHarness --> Bundled
PureGo --> Scheduler
MF --> Scheduler
Bundled --> Scheduler
PureGo --> Metrics
MF --> Metrics
Bundled --> Metrics
Legal --> ADR
Metrics --> ADR
Variants --> ADR
Scheduler --> ADR
ADR --> Handoff : freeze reusable seams
ADR -[#red]-> Production : no-go
Handoff --> Production : only after every gate passes

@enduml
