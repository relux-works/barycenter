  "reviewedClaims": [
    {"id": "encryption", "result": "match", "claim": "Phase 1 coordinator-readable audio is explicitly not end-to-end encrypted; Phase 3 e2ee_media remains deferred and disabled."},
    {"id": "metadata", "result": "match", "claim": "Policy names coordinator-visible identifiers, routing, receipts, reports and restricted evidence metadata without claiming content secrecy."},
    {"id": "deletion", "result": "match", "claim": "Access revocation is immediate while physical cleanup is asynchronous and cannot erase recipient, integration, evidence-hold, lawful-hold or expiring backup copies."},
    {"id": "recovery", "result": "match", "claim": "Recovery requires surviving authority and does not promise recovery after all authorized credentials are lost."},
    {"id": "telegram", "result": "match", "claim": "Telegram is optional, Telegram-controlled copies remain outside Pulsar deletion, and linked actor policy still gates upload and transmission."},
    {"id": "report-evidence", "result": "match", "claim": "Evidence is report-bound, capability-gated, auditable, expires after 30 days and cannot be read through list-only or revoked credentials."},
    {"id": "ugc-and-store", "result": "hold", "claim": "Repository copy is internally consistent, but public URLs, mailbox delivery, exact IARC portal output, screenshots, WACK, exact-build certification and submission authority evidence are not claimed."}
  ],
