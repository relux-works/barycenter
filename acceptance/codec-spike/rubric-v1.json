  "decodedPCM": {
    "sampleRateHz": 48000,
    "channels": 2,
    "sampleFormat": "float32-interleaved",
    "comparison": "Decoded duration must be within one output frame and marker windows within 20 ms of the fixture lock.",
    "markers": "Stereo synthetic tones change every 10 seconds through six bands per minute; the fixture lock records the measured duration and every seek sample records expected and observed marker bands."
  },
  "packageArchitectures": {
    "windowsBuild": ["amd64", "arm64"],
    "macosBuild": ["arm64"],
    "minimumRealTimingMatrix": ["Windows x64 packaged node", "Apple-silicon macOS packaged node"]
  },
  "commands": {
    "generateCorpus": "python3 scripts/codec_spike/generate_fixtures.py --output <private-dir> --lock <fixture-lock.json>",
    "serveCorpus": "CODEC_SPIKE_TOKEN=<secret> python3 scripts/codec_spike/range_harness.py --fixtures <private-dir> --lock <fixture-lock.json> --target <opaque-target> --ready-file <ready.json> --log <requests.jsonl>",
    "evaluateEvidence": "python3 scripts/codec_spike/evaluate_evidence.py <evidence.json> --output <evaluation.json>",
    "validateContract": "python3 scripts/codec_spike/validate_contract.py",
    "validateLicenseAudit": "python3 scripts/codec_spike/validate_license_audit.py"
  },
  "requiredPairings": [
    "windows_windows",
    "windows_macos",
    "macos_macos"
  ],
  "samplePlan": {
    "warmupsPerTimedGroup": 3,
    "measuredSamplesPerTimedGroup": 30,
    "percentileMethod": "nearest-rank",
    "order": "Seeded shuffle recorded in the evidence artifact; warmups run before measured samples; failures are retained and never discarded.",
    "clocks": "Coordinator monotonic milliseconds plus each node's monotonic first-audio timestamp; wall clocks are metadata only.",
    "rss": "Sample process-tree RSS once per second from prepare through drain. Record baseline, peak, one-hour p95, final-ten-minute p95 and two-hour least-squares slope.",
    "diskCache": "Sample app-private cache bytes once per second and after eviction, revoke and shutdown. The candidate declares its ceiling; the next transport task freezes the production ceiling.",
    "network": "Loopback is allowed for repository correctness. Final timing uses recorded sufficient-network topology and also repeats the frozen slow/reset profiles."
  },
  "hardGates": [
    {
      "metric": "track_start_ms",
      "method": "nearest-rank-p95",
      "limit": 5000,
      "unit": "ms",
      "warmups": 3,
      "samples": 30,
      "groupBy": ["candidateId", "buildSha256", "pairing", "nodeId", "fixtureId"]
    },
    {
      "metric": "seek_to_audio_ms",
      "method": "nearest-rank-p95",
      "limit": 3000,
      "unit": "ms",
      "warmups": 3,
      "samples": 30,
      "groupBy": ["candidateId", "buildSha256", "pairing", "nodeId", "fixtureId"]
    },
    {
      "metric": "scheduled_skew_ms",
      "method": "nearest-rank-p95",
      "limit": 100,
      "unit": "ms",
      "warmups": 3,
      "samples": 30,
      "groupBy": ["candidateId", "buildSha256", "pairing", "fixtureId"]
    },
    {
      "metric": "peak_rss_mib",
      "method": "maximum",
      "limit": 200,
      "unit": "MiB",
      "warmups": 0,
      "samples": 1,
      "groupBy": ["candidateId", "buildSha256", "pairing", "nodeId", "fixtureId"]
    },
    {
      "metric": "duration_rss_growth_mib",
      "method": "maximum",
      "limit": 16,
      "unit": "MiB",
      "warmups": 0,
      "samples": 1,
      "groupBy": ["candidateId", "buildSha256", "pairing", "nodeId"]
    },
    {
      "metric": "duration_rss_slope_mib_per_hour",
      "method": "absolute-maximum",
      "limit": 1,
      "unit": "MiB/hour",
      "warmups": 0,
      "samples": 1,
      "groupBy": ["candidateId", "buildSha256", "pairing", "nodeId"]
    }
  ],
  "zeroFailureChecks": [
    "decode_expected_pcm",
    "start_before_full_download",
    "pause_holds_audible_position",
    "resume_uses_same_generation",
    "seek_uses_new_generation_and_range",
    "ended_after_decoder_and_output_drain",
    "cache_never_exceeds_declared_ceiling",
    "evicted_or_revoked_bytes_are_not_replayed",
    "hostile_input_rejected_without_crash",
    "render_callback_has_no_network_disk_allocation_wait_or_blocking_lock"
  ],
