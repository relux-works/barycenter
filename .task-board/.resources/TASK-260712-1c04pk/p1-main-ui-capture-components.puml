actor User

package "Story TASKs" {
  rectangle "TASK-260712-2lrpc0\nBuiltin cue + temp media contract" as Cue
  rectangle "TASK-260712-9i5se7\nWindows shell" as WinShell
  rectangle "TASK-260712-1p8ykc\nWindows capture/self-test" as WinCap
  rectangle "TASK-260712-2fe5bz\nWindows integration" as WinData
  rectangle "TASK-260712-1c04pk\nmacOS shell" as MacShell
  rectangle "TASK-260712-1s6h6t\nmacOS capture/self-test" as MacCap
  rectangle "TASK-260712-3dqc3l\nmacOS integration" as MacData
  rectangle "TASK-260712-e5mfqj\nVerification evidence" as Verify
}

package "External story dependencies" {
  rectangle "STORY-260712-30ju1k\nWindows packaged-app spike" as WinSpike
  rectangle "STORY-260712-2ve1c8\nIdentity + onboarding APIs" as Identity
  rectangle "STORY-260712-ld674h\nMedia ingest + upload sessions" as Ingest
  rectangle "STORY-260712-25lysg\nTransmission protocol + receipts" as Tx
  rectangle "STORY-260712-34kbkn\nHistory/presence parity" as Presence
