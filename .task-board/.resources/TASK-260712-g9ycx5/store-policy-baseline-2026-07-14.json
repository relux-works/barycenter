  "requirements": [
    {
      "id": "10.1",
      "classification": "mandatory",
      "summary": "The product and all metadata must accurately represent the shipped source, functions, features, experience and material limitations.",
      "source_ids": ["store-policies", "msix-listing"],
      "owner_tasks": ["TASK-260712-e1ie4x", "TASK-260712-2s4e9p", "TASK-260712-38lssj"],
      "evidence_tasks": ["TASK-260712-e5mfqj", "TASK-260712-1xik11"]
    },
    {
      "id": "10.3",
      "classification": "mandatory",
      "summary": "The submitted product must be testable; credentials are supplied only when login is actually required, and every server required by the reviewer path must remain functional.",
      "source_ids": ["store-policies", "store-submission-faq"],
      "owner_tasks": ["TASK-260712-1cdoxh", "TASK-260712-2s4e9p"],
      "evidence_tasks": ["TASK-260712-e5mfqj", "TASK-260712-1xik11"]
    },
    {
      "id": "10.5",
      "classification": "mandatory",
      "summary": "A Win32 product must expose an up-to-date privacy policy covering accessed personal information, use, storage, security, disclosure, controls and access; personal information must be transmitted and stored securely.",
      "source_ids": ["store-policies", "msix-properties"],
      "owner_tasks": ["TASK-260712-1epb3a", "TASK-260712-1x0lot"],
      "evidence_tasks": ["TASK-260712-e1ie4x", "TASK-260712-1xik11"]
    },
    {
      "id": "10.6",
      "classification": "mandatory",
      "summary": "Every declared capability must legitimately relate to shipped functionality and must not circumvent operating-system capability checks.",
      "source_ids": ["store-policies", "msix-properties", "wack"],
      "owner_tasks": ["TASK-260712-e1ie4x"],
      "evidence_tasks": ["TASK-260712-1cdoxh", "TASK-260712-e5mfqj"]
    },
    {
      "id": "10.7",
      "classification": "mandatory",
      "summary": "The product and listing must be localized for every declared language, disclose unavailable localized features and provide a reasonably similar experience across supported languages.",
      "source_ids": ["store-policies", "msix-listing", "msix-assets"],
      "owner_tasks": ["TASK-260712-e1ie4x", "TASK-260712-2s4e9p"],
      "evidence_tasks": ["TASK-260712-e5mfqj", "TASK-260712-1xik11"]
    },
    {
      "id": "11.11",
      "classification": "mandatory",
      "summary": "Partner Center must obtain an age rating from an accurately completed IARC questionnaire; content changes that can affect the rating require a questionnaire update.",
      "source_ids": ["store-policies", "microsoft-age-ratings", "iarc-about", "iarc-faq", "iarc-process"],
      "owner_tasks": ["TASK-260712-2s4e9p"],
      "evidence_tasks": ["TASK-260712-1xik11"]
    },
    {
      "id": "11.12",
      "classification": "mandatory",
      "summary": "Online UGC requires published terms or content guidelines, in-product reporting or proactive detection, and the ability to remove or disable UGC when Microsoft requests it.",
      "source_ids": ["store-policies"],
      "owner_tasks": ["TASK-260712-1epb3a", "TASK-260712-1x0lot", "TASK-260712-3t9nr8", "TASK-260712-pbfz37"],
      "evidence_tasks": ["TASK-260712-2kec2s", "TASK-260712-2s4e9p", "TASK-260712-1xik11"]
    }
  ],
